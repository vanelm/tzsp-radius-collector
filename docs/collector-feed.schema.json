{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanelm.github.io/tzsp-radius-collector/schemas/collector-feed.schema.json",
  "title": "TZSP RADIUS Collector Feed Message",
  "description": "WebSocket stream event emitted by tzsp-radius-collector.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "source",
    "radius",
    "decoded_attributes"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC event timestamp generated by the collector."
    },
    "source": {
      "type": "string",
      "description": "Capture source label.",
      "enum": [
        "tzsp_udp",
        "raw_sniff",
        "synthetic",
        "replay",
        "forward",
        "forward-response"
      ]
    },
    "remote_addr": {
      "type": "string",
      "description": "Remote sender address when available (usually for tzsp_udp mode)."
    },
    "capture_interface": {
      "type": "string",
      "description": "Network interface name when available (usually for raw_sniff mode)."
    },
    "src_addr": {
      "type": "string",
      "description": "L3 source address extracted from the captured frame when available."
    },
    "dst_addr": {
      "type": "string",
      "description": "L3 destination address extracted from the captured frame when available."
    },
    "radius": {
      "$ref": "#/$defs/radius_packet"
    },
    "decoded_attributes": {
      "type": "array",
      "description": "Decoded RADIUS attributes. Standard and VSA are represented with different object variants.",
      "items": {
        "$ref": "#/$defs/decoded_attribute"
      }
    },
    "accounting": {
      "$ref": "#/$defs/accounting_snapshot"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Collector-side decode/processing errors for this event."
    }
  },
  "$defs": {
    "radius_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "code_name",
        "identifier",
        "length",
        "authenticator"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "code_name": {
          "type": "string",
          "description": "Human-readable RADIUS code (for example Access-Request, Accounting-Request)."
        },
        "identifier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "length": {
          "type": "integer",
          "minimum": 20,
          "maximum": 65535
        },
        "authenticator": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "RADIUS authenticator as lowercase hex."
        }
      }
    },
    "decoded_attribute_standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "attr_id",
        "is_vsa",
        "value",
        "raw"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "attr_id": {
          "type": "integer",
          "minimum": 0
        },
        "is_vsa": {
          "const": false
        },
        "value": {
          "type": "string",
          "description": "Display value after dictionary-aware decode."
        },
        "raw": {
          "type": "string",
          "description": "Raw fallback representation (printable text or hex)."
        },
        "enum_name": {
          "type": "string"
        },
        "vendor_id": {
          "type": "integer",
          "minimum": 0,
          "description": "May be present as 0 in current implementation for non-VSA attributes."
        },
        "vendor_name": {
          "type": "string",
          "description": "Usually empty for standard attributes."
        }
      }
    },
    "decoded_attribute_vsa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "vendor_id",
        "attr_id",
        "is_vsa",
        "value",
        "raw"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor_id": {
          "type": "integer",
          "minimum": 1
        },
        "vendor_name": {
          "type": "string"
        },
        "attr_id": {
          "type": "integer",
          "minimum": 0
        },
        "is_vsa": {
          "const": true
        },
        "value": {
          "type": "string",
          "description": "Display value after dictionary-aware decode."
        },
        "raw": {
          "type": "string",
          "description": "Raw fallback representation (printable text or hex)."
        },
        "enum_name": {
          "type": "string"
        }
      }
    },
    "decoded_attribute": {
      "oneOf": [
        {
          "$ref": "#/$defs/decoded_attribute_standard"
        },
        {
          "$ref": "#/$defs/decoded_attribute_vsa"
        }
      ]
    },
    "accounting_snapshot": {
      "type": "object",
      "description": "Accounting summary object extracted from decoded attributes. Keys are intentionally open because dictionary/runtime behavior may evolve.",
      "additionalProperties": true,
      "properties": {
        "mac": {
          "type": "string"
        },
        "status_type": {
          "type": "string"
        },
        "acct_session_id": {
          "type": "string"
        },
        "acct_multi_session_id": {
          "type": "string"
        },
        "user_name": {
          "type": "string"
        },
        "calling_station_id": {
          "type": "string"
        },
        "called_station_id": {
          "type": "string"
        },
        "nas": {
          "type": "string"
        },
        "nas_identifier": {
          "type": "string"
        },
        "nas_vendor": {
          "type": "string"
        },
        "framed_ip": {
          "type": "string"
        },
        "session_time_sec": {
          "type": "integer",
          "minimum": 0
        },
        "input_octets": {
          "type": "integer",
          "minimum": 0
        },
        "output_octets": {
          "type": "integer",
          "minimum": 0
        },
        "input_packets": {
          "type": "integer",
          "minimum": 0
        },
        "output_packets": {
          "type": "integer",
          "minimum": 0
        },
        "terminate_cause": {
          "type": "string"
        },
        "last_event_at": {
          "type": "string",
          "format": "date-time"
        },
        "online": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_interim_at": {
          "type": "string",
          "format": "date-time"
        },
        "stopped_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
