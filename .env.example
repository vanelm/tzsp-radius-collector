# TZSP Collector HTTP and WebSocket
URSA_APP_ENV=development
# Optional override: debug|info|warn|error
URSA_LOG_LEVEL=
URSA_TZSP_HTTP_LISTEN=:8098
URSA_TZSP_WS_PATH=/ws
URSA_TZSP_EVENT_QUEUE=1024
URSA_TZSP_CLIENT_QUEUE=128

# Capture modes
URSA_TZSP_ENABLE_UDP=true
URSA_TZSP_UDP_LISTEN=:37008
URSA_TZSP_ENABLE_RAW_SNIFF=false
URSA_TZSP_SNIFF_IFACE=eth0
URSA_TZSP_SNIFF_FILTER=udp and (port 1812 or port 1813)
URSA_TZSP_SNIFF_PROMISCUOUS=false

# Dictionary loading
URSA_TZSP_DICTIONARY_GLOB=./config/dictionary/dictionary.*

# mDNS/DNS-SD advertisement
URSA_TZSP_ENABLE_MDNS=true
URSA_TZSP_MDNS_NAME=tzsp-radius-collector
URSA_TZSP_MDNS_PORT=8098

# Test harness
URSA_TZSP_DB_PATH=./data/collector.db
URSA_TZSP_FORWARD_AUTH_TARGET=127.0.0.1:1812
URSA_TZSP_FORWARD_ACCT_TARGET=127.0.0.1:1813
